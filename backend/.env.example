# Environment Variables Template
# Copy this file to .env and fill in your values

# LLM API Keys (at least one required)
# Groq is recommended - free and fast!
GROQ_API_KEY=your_groq_api_key_here

# Production model and fallback recommended by Groq after the August 2026
# retirement of the previous 70B model for developer-tier usage.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# OpenAI (optional, used as fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://shashibhushanjha.me,http://localhost:3000

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60
